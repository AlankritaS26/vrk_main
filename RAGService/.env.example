# ── Embedding provider ─────────────────────────────────────────────────
# "local"        → BAAI/bge-large-en-v1.5 (1024-dim, runs on-premise, zero cloud)
# "azure_openai" → text-embedding-ada-002 (1536-dim, Azure enterprise tenant)
EMBEDDING_PROVIDER=local
BGE_DEVICE=cpu
# BGE_DEVICE=cuda   # uncomment if a GPU is available

# ── Azure OpenAI (only needed if EMBEDDING_PROVIDER=azure_openai) ──────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── RAG tuning ─────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=10

# ── API server ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8600
API_WORKERS=1
